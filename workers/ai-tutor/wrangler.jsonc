{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learncodevisually-ai-tutor",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://learncodevisually.com",
    "MODEL_NAME": "@cf/google/gemma-4-26b-a4b-it",
    "AI_ENABLED": "false"
  }
}
