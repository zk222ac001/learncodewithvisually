{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learncodevisually-budget-smoke-local",
  "main": "src/budget-smoke.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_BUDGET",
        "class_name": "AiDailyBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AiDailyBudget"
      ]
    }
  ]
}
